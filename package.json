{
  "name": "video-to-thumbnail",
  "packageManager": "pnpm@12.15.0",
  "description": "Generate PNG thumbnails from local video files or remote video URLs using ffmpeg, with built-in concurrency control.",
  "version": "2.0.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=60000",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm test && pnpm run build && pnpm run test:package",
    "example": "node examples/basic-usage.js",
    "example:concurrent": "node examples/concurrent-usage.js",
    "example:cancellation": "node examples/cancellation.js",
    "prepublishOnly": "pnpm run verify",
    "lint": "oxlint --deny-warnings src test scripts examples",
    "lint:fix": "oxlint --fix src test scripts examples",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "video",
    "thumbnail",
    "ffmpeg",
    "screenshot",
    "poster",
    "preview",
    "mp4",
    "image",
    "frame"
  ],
  "author": {
    "name": "awaisjameel",
    "email": "awais.jameel@ymail.com",
    "url": "https://github.com/awaisjameel"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awaisjameel/video-to-thumbnail.git"
  },
  "bugs": {
    "url": "https://github.com/awaisjameel/video-to-thumbnail/issues"
  },
  "homepage": "https://github.com/awaisjameel/video-to-thumbnail#readme",
  "dependencies": {
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
